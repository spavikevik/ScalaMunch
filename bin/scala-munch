#!/usr/bin/env bash
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
JAR="$SCRIPT_DIR/../cli/target/scala-3.3.3/scala-munch-cli-assembly.jar"
if [[ ! -f "$JAR" ]]; then
  echo "[scala-munch] CLI jar not found. Run bin/install.sh first." >&2
  exit 1
fi
exec java -jar "$JAR" "$@"
